# Never commit game files: each user imports their own copy.
/factorio*/
*.tar.xz
*.zip
/data/
/saves/

# Build output
.gradle/
build/
local.properties
*.apk
*.keystore
.DS_Store

# Runtime build output
/runtime/out/
/runtime/work/
/runtime/out-*.log
.cxx/

# Rendered controls (art/controls): previews and full-size pictures; the app takes the WebP copies
/art/controls/sprites/
/art/controls/*.mp4
/art/controls/*.png
