<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launcher: landscape and edge to edge like the game, on the blueprint's navy until the stage draws. -->
    <style name="Theme.PocketFoundry.Launcher" parent="android:Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/stage</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="stage">#091726</color>
</resources>
