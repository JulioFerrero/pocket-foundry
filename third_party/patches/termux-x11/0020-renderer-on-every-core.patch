 void* Renderer::initThread() {
+    // Pocket Foundry: the X server's process keeps to the upper half of the cores (cmdentrypoint.cpp). The renderer,
+    // which ran in the app's process before, may use them all again.
+    cpu_set_t everyCore;
+    CPU_ZERO(&everyCore);
+    for (long i = 0, cores = sysconf(_SC_NPROCESSORS_CONF); i < cores && i < CPU_SETSIZE; i++)
+        CPU_SET(i, &everyCore);
+    if (sched_setaffinity(0, sizeof(everyCore), &everyCore) == -1)
+        log("Renderer can't use every core: %s", strerror(errno));
