+#undef MOVED
+    lastUpdated = updated, lastFlipped = flipped, lastDrawn = drawn, lastSurface = surface;
+    fprintf(stderr, "frames: %d/s from the game (%d/s flipped), %d/s drawn on screen%s\n", updated, flipped, drawn,
+            surface ? "" : ", no screen surface");
+}
