-#define log(...) __android_log_print(ANDROID_LOG_DEBUG, "gles-renderer", __VA_ARGS__)
-#define loge(...) __android_log_print(ANDROID_LOG_ERROR, "gles-renderer", __VA_ARGS__)
+#define log(...) do { \
+    __android_log_print(ANDROID_LOG_DEBUG, "gles-renderer", __VA_ARGS__); \
+    if (detailedLogs) screenLog(__VA_ARGS__); \
+} while (0)
+#define loge(...) do { \
+    __android_log_print(ANDROID_LOG_ERROR, "gles-renderer", __VA_ARGS__); \
+    if (detailedLogs) screenLog(__VA_ARGS__); \
+} while (0)
+
+/* Pocket Foundry's Detailed logs, which the X server turns on through the shared state: the log goes to stderr too,
+ * where the app keeps "screen: " lines in screen.log. A line that repeats the one before is counted, not written. */
+static volatile bool detailedLogs = false;
+
+static void screenLog(const char* format, ...) {
+    static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+    static char last[256];
+    static int repeats;
+    char line[256];
+    va_list args;
+    va_start(args, format);
+    vsnprintf(line, sizeof(line), format, args);
+    va_end(args);
+    line[strcspn(line, "\n")] = 0;
+
+    pthread_mutex_lock(&lock);
+    if (!strcmp(line, last))
+        repeats++;
+    else {
+        if (repeats)
+            fprintf(stderr, "screen: (the line before %d more times)\n", repeats);
+        fprintf(stderr, "screen: %s\n", line);
+        strcpy(last, line);
+        repeats = 0;
+    }
+    pthread_mutex_unlock(&lock);
+}
 
