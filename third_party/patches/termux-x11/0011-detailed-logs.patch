+static void lorieLogFrames(int updated, int flipped, int drawn, Bool surface) {
+    static int lastUpdated = -1, lastFlipped = -1, lastDrawn = -1, lastSurface = -1;
+#define MOVED(now, last) (abs((now) - (last)) >= 3 || ((now) == 0) != ((last) == 0))
+    if (!MOVED(updated, lastUpdated) && !MOVED(flipped, lastFlipped) && !MOVED(drawn, lastDrawn) && surface == lastSurface)
