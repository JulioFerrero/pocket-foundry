diff --git a/lorie/src/main/cpp/lorie/cmdentrypoint.cpp b/lorie/src/main/cpp/lorie/cmdentrypoint.cpp
index d59c1e4..e6b5559 100644
--- a/lorie/src/main/cpp/lorie/cmdentrypoint.cpp
+++ b/lorie/src/main/cpp/lorie/cmdentrypoint.cpp
@@ -679,6 +679,11 @@ void lorieListenForKnocks(int port, const char *tag) {
             static int knocks = 0;
             if (knocks++ < 3)
                 log(DEBUG, "New client connection!");
+            // Pocket Foundry: a connected screen doesn't knock, yet on some Xiaomis something knocks 2-4 times a
+            // second all game. Says so the first time and every 100th, to tell who it is from the screen's side.
+            static int knocksWhileConnected = 0;
+            if (conn_fd != -1 && knocksWhileConnected++ % 100 == 0)
+                log(ERROR, "knock %d while a screen is connected", knocksWhileConnected);
             serverEnv->CallVoidMethod(thiz, sendBroadcast);
         }
         close(client);
