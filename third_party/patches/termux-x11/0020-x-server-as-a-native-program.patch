+// Pocket Foundry: run as a native program, the server takes the screen's connections on $LORIE_SOCKET.
+static void listenForScreens(void) {
+    const char *path = getenv("LORIE_SOCKET");
+    struct sockaddr_un address = { .sun_family = AF_UNIX };
+    int fd;
+
+    if (!path || strlen(path) >= sizeof(address.sun_path))
+        FatalError("LORIE_SOCKET isn't a socket's path: %s", path ?: "not set");
+    strcpy(address.sun_path, path);
+    unlink(path);
+    if ((fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0)) < 0
+            || bind(fd, (struct sockaddr *) &address, sizeof(address)) < 0 || listen(fd, 4) < 0)
+        FatalError("Can't listen for the screen on %s: %s", path, strerror(errno));
+
+    SetNotifyFd(fd, +[](int fd, int ready, __unused void *data) {
+        int client;
+
+        if (ready & X_NOTIFY_ERROR) {
+            RemoveNotifyFd(fd);
+            close(fd);
+            return;
+        }
+        if ((client = accept4(fd, nullptr, nullptr, SOCK_CLOEXEC)) < 0) {
+            log(ERROR, "Failed to accept the screen's connection: %s", strerror(errno));
+            return;
+        }
+        log(INFO, "The screen connected");
+        takeConnection(client);
+    }, X_NOTIFY_READ, NULL);
