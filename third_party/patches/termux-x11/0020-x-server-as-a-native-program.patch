diff --git a/lorie/src/main/cpp/lorie/server.c b/lorie/src/main/cpp/lorie/server.c
new file mode 100644
index 0000000..09f331c
--- /dev/null
+++ b/lorie/src/main/cpp/lorie/server.c
@@ -0,0 +1,29 @@
+// Pocket Foundry: the X server as a native program, run by the host app: lorieServerMain in libXlorie.so, which
+// $XLORIE_LIB names or which sits next to this program. Named like a library (libXlorie-server.so) so Android installs
+// it where an app may run programs.
+#include <dlfcn.h>
+#include <libgen.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+int main(int argc, char **argv) {
+    char path[PATH_MAX], self[PATH_MAX] = {0};
+    const char *lib = getenv("XLORIE_LIB");
+    if (!lib) {
+        if (readlink("/proc/self/exe", self, sizeof(self) - 1) < 0) {
+            perror("Xlorie-server: /proc/self/exe");
+            return 1;
+        }
+        snprintf(path, sizeof(path), "%s/libXlorie.so", dirname(self));
+        lib = path;
+    }
+    void *handle = dlopen(lib, RTLD_NOW);
+    int (*serverMain)(int, char **) = handle ? (int (*)(int, char **)) dlsym(handle, "lorieServerMain") : NULL;
+    if (!serverMain) {
+        fprintf(stderr, "Xlorie-server: no X server in %s: %s\n", lib, dlerror());
+        return 1;
+    }
+    return serverMain(argc, argv);
+}
