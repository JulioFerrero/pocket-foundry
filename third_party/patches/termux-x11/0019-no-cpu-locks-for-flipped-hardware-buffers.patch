diff --git a/lorie/src/main/cpp/lorie/InitOutput.c b/lorie/src/main/cpp/lorie/InitOutput.c
index 682bcbb..6305852 100644
--- a/lorie/src/main/cpp/lorie/InitOutput.c
+++ b/lorie/src/main/cpp/lorie/InitOutput.c
@@ -702,7 +702,13 @@ void lorieSetWindowPixmap(WindowPtr pWindow, PixmapPtr newPixmap) {
             old->locked = NULL;
             old->wasLocked = false;
         }
-        if (new && new->buffer && !new->locked) {
+        // Pocket Foundry: not a client's hardware buffer flipped in, which only its GPU draws: each lock and unlock of
+        // one the CPU may read syncs its cache, a whole frame's worth each time, and lorieSyncRootForGpu would do both
+        // for every frame the renderer draws. Unlocked, it skips it. loriePrepareAccess locks it if the server ever
+        // draws on it.
+        bool clients = newPixmap != pScreenPtr->GetScreenPixmap(pScreenPtr) && new && new->buffer &&
+                       LorieBuffer_description(new->buffer)->type == LORIEBUFFER_AHARDWAREBUFFER;
+        if (new && new->buffer && !new->locked && !clients) {
             LorieBuffer_lock(new->buffer, &new->locked);
             new->wasLocked = false;
         }
