+/* Pocket Foundry: the program the app started through the loader, when it set one.  */
+static const char *
+pocketfoundry_program (void)
+{
+  static const char name[] = "POCKETFOUNDRY_PROGRAM=";
+  for (char **ep = _environ; ep != NULL && *ep != NULL; ++ep)
+    if (strncmp (*ep, name, sizeof name - 1) == 0 && (*ep)[sizeof name - 1] != '\0')
+      return *ep + sizeof name - 1;
+  return NULL;
+}
