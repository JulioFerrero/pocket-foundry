 		break;
 	      }
+	    else if (pocketfoundry_program () != NULL)
+	      {
+		/* Pocket Foundry: a program that restarts itself through
+		   /proc/self/exe (Factorio, after a change to its mods) runs
+		   the loader again with only its own arguments, so the first
+		   one looks like an unknown option.  Run the program the app
+		   named, with those arguments as they are; the library path
+		   comes from GLIBC_LD_LIBRARY_PATH.  */
+		_dl_argv[0] = (char *) pocketfoundry_program ();
+		restarted = true;
+		break;
+	      }
 	    else
