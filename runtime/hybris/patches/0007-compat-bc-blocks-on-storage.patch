+/* Pocket Foundry: images whose blocks are on storage (bc_shadow.h). Between two of them the file copies the
+ * blocks at submission and the GPU copies the converted images, or converts again from the file where they were
+ * converted differently. From a native image (Factorio's GPU compressor) the GPU converts from a copy of it, which
+ * the file can't follow. To a native image the blocks come from the file. */
+static void shadow_images(struct hybris_bc_device *device, struct hybris_bc_command *command,
+    const struct hybris_bc_resource *source, VkImageLayout source_layout,
