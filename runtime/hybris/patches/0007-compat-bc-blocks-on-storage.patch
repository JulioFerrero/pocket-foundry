+/* SPDX-License-Identifier: Apache-2.0 */
+#define _GNU_SOURCE
+#define VK_NO_PROTOTYPES
+#include "bc_shadow.h"
+#include "bc_context.h"
+#include "memory_visibility.h"
+#include <errno.h>
