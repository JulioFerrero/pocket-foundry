+    converted.imageExtent.depth = destination->type == VK_IMAGE_TYPE_3D ? layers : 1;
+    VkResult result = VK_SUCCESS;
+    if (source->emulated.image && destination->emulated.image) {
+        struct hybris_bc_shadow_op *copy = hybris_bc_shadow_record(&t->shadow, HYBRIS_BC_SHADOW_COPY, destination->handle);
+        if (!copy) { command->state.error = VK_ERROR_OUT_OF_HOST_MEMORY; return; }
+        copy->source = source->handle;
+        for (uint32_t layer = 0; layer < layers; ++layer)
+            for (uint32_t y = 0; y < rows; ++y)
+                if (!hybris_bc_shadow_segment(copy,
+                        block_offset(&source->emulated, &region->srcSubresource, region->srcOffset, layer, y),
+                        block_offset(&destination->emulated, &region->dstSubresource, region->dstOffset, layer, y), row)) {
+                    command->state.error = VK_ERROR_OUT_OF_HOST_MEMORY; return;
+                }
+        if (source->emulated.decoded_format == destination->emulated.decoded_format) {
+            CmdCopyImage(command->handle, source->handle, source_layout, destination->handle, destination_layout, 1, region);
+            return;
+        }
+        VkBuffer staging;
+        struct hybris_bc_shadow_op *fill = hybris_bc_shadow_record(&t->shadow, HYBRIS_BC_SHADOW_FILL, destination->handle);
+        if (!fill) { command->state.error = VK_ERROR_OUT_OF_HOST_MEMORY; return; }
+        result = hybris_bc_transfer_buffer(t, slice * layers, 1, &staging, &fill->staging);
+        for (uint32_t layer = 0; layer < layers && result == VK_SUCCESS; ++layer)
+            for (uint32_t y = 0; y < rows; ++y)
+                if (!hybris_bc_shadow_segment(fill,
+                        block_offset(&destination->emulated, &region->dstSubresource, region->dstOffset, layer, y),
+                        layer * slice + y * row, row)) { result = VK_ERROR_OUT_OF_HOST_MEMORY; break; }
+        if (result == VK_SUCCESS)
+            hybris_bc_decode_buffer(t, command->handle, &command->state, &destination->emulated, destination_layout,
+                &converted, staging, 0, row, slice);
+    } else if (destination->emulated.image) {
+        VkBuffer copied;
+        result = hybris_bc_transfer_buffer(t, slice * layers, 0, &copied, NULL);
+        for (uint32_t layer = 0; layer < layers && result == VK_SUCCESS; ++layer) {
+            VkBufferImageCopy copy = {.bufferOffset = layer * slice,
+                .bufferRowLength = columns * source_block.width, .bufferImageHeight = rows * source_block.height,
+                .imageSubresource = region->srcSubresource, .imageOffset = region->srcOffset,
+                .imageExtent = {region->extent.width, region->extent.height, 1}};
+            copy.imageSubresource.layerCount = 1;
