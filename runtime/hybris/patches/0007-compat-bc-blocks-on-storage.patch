+
+#define ALIGN (UINT64_C(1) << 16)
+#define REPORT_STEP (UINT64_C(256) << 20)
+
+static pthread_once_t mode_once = PTHREAD_ONCE_INIT;
+static int enabled;
+static void read_mode(void)
+{
+    const char *value = getauxval(AT_SECURE) ? NULL : getenv("HYBRIS_BC_BLOCKS");
+    enabled = !value || strcmp(value, "gpu");
+}
+int hybris_bc_shadow_enabled(void)
+{
+    pthread_once(&mode_once, read_mode);
+    return enabled;
+}
+
+static pthread_mutex_t file_guard = PTHREAD_MUTEX_INITIALIZER;
+static int file = -2;
+static VkDeviceSize file_end, written, reported;
+
+static int open_file(void)
+{
+    if (file != -2) return file;
+    const char *folder = getauxval(AT_SECURE) ? NULL : getenv("TMPDIR");
+    char path[4096];
+    snprintf(path, sizeof(path), "%s/hybris-bc-blocks-XXXXXX", folder && *folder ? folder : "/tmp");
+    file = mkostemp(path, O_CLOEXEC);
+    if (file >= 0) {
+        unlink(path);
+        fprintf(stderr, "HYBRIS_BC_SHADOW converted textures keep their BC blocks on storage, in %s\n",
+            folder && *folder ? folder : "/tmp");
+    } else {
+        fprintf(stderr, "HYBRIS_BC_SHADOW no file for the BC blocks (%s): read-backs come back empty\n",
+            strerror(errno));
+        file = -1;
+    }
+    return file;
+}
+/* Mapped, the blocks of a row are a memory copy rather than a system call: Factorio uploads its sprites a few
+ * rows at a time. The range is allocated on storage first, so a full storage fails here, not in a later copy. */
+unsigned char *hybris_bc_shadow_reserve(VkDeviceSize size, VkDeviceSize *offset)
+{
+    unsigned char *map = NULL;
+    pthread_mutex_lock(&file_guard);
+    VkDeviceSize length = (size + ALIGN - 1) / ALIGN * ALIGN;
+    if (open_file() >= 0 && size && file_end <= (VkDeviceSize)INT64_MAX - length) {
+        int error = fallocate(file, 0, (off_t)file_end, (off_t)length) ? errno : 0;
+        void *mapped = error ? MAP_FAILED :
+            mmap(NULL, length, PROT_READ | PROT_WRITE, MAP_SHARED, file, (off_t)file_end);
+        if (mapped != MAP_FAILED) {
+            map = mapped;
+            *offset = file_end;
+            file_end += length;
+        } else {
+            static int told;
+            if (!error) error = errno;
+            if (!told) {
+                told = 1;
+                fprintf(stderr, "HYBRIS_BC_SHADOW no room on storage for a texture's blocks (%s): reading it "
+                    "back gives zeros\n", strerror(error));
+            }
+            fallocate(file, FALLOC_FL_PUNCH_HOLE | FALLOC_FL_KEEP_SIZE, (off_t)file_end, (off_t)length);
+        }
+    }
+    pthread_mutex_unlock(&file_guard);
+    return map;
+}
+void hybris_bc_shadow_release(unsigned char *map, VkDeviceSize offset, VkDeviceSize size)
+{
+    VkDeviceSize length = (size + ALIGN - 1) / ALIGN * ALIGN;
+    munmap(map, length);
+    /* The range is never handed out again: give its storage back. */
+    fallocate(file, FALLOC_FL_PUNCH_HOLE | FALLOC_FL_KEEP_SIZE, (off_t)offset, (off_t)length);
+}
+
+struct hybris_bc_shadow_op *hybris_bc_shadow_record(struct hybris_bc_shadow_ops *ops,
+    enum hybris_bc_shadow_kind kind, VkImage image)
+{
+    struct hybris_bc_shadow_op *op = calloc(1, sizeof(*op));
+    if (!op) return NULL;
+    op->kind = kind;
+    op->image = image;
+    if (ops->last) ops->last->next = op; else ops->first = op;
+    ops->last = op;
+    return op;
+}
+int hybris_bc_shadow_segment(struct hybris_bc_shadow_op *op, VkDeviceSize from, VkDeviceSize to, VkDeviceSize size)
+{
+    if (!size) return 1;
+    if (op->count) {
+        struct hybris_bc_shadow_segment *last = &op->segments[op->count - 1];
+        /* Rows that follow each other on both sides: one read or write. */
+        if (last->from + last->size == from && last->to + last->size == to) { last->size += size; return 1; }
+    }
+    if (op->count == op->capacity) {
+        uint32_t capacity = op->capacity ? op->capacity * 2 : 16;
+        void *grown = realloc(op->segments, (size_t)capacity * sizeof(*op->segments));
+        if (!grown) return 0;
+        op->segments = grown;
+        op->capacity = capacity;
+    }
+    op->segments[op->count++] = (struct hybris_bc_shadow_segment){from, to, size};
+    return 1;
+}
+void hybris_bc_shadow_clear(struct hybris_bc_shadow_ops *ops)
+{
+    while (ops->first) {
+        struct hybris_bc_shadow_op *next = ops->first->next;
+        free(ops->first->segments);
+        free(ops->first);
+        ops->first = next;
+    }
+    ops->last = NULL;
+}
+
+/* What the copies of a submission touched stays in the file and the page cache, but not in this process's memory:
+ * the kernel writes it out and can drop it, and Android doesn't count it against the game. Let go once per
+ * submission, while its images are surely alive: once per copy cost Factorio's first start 8 s out of 44. */
+struct touched { unsigned char *map; VkDeviceSize low, high; };
+#define TOUCHED_MAX 64
+static struct touched touched[TOUCHED_MAX];
+static uint32_t touched_count;
+static void let_go_all(void)
+{
+    static VkDeviceSize page;
+    if (!page) page = (VkDeviceSize)sysconf(_SC_PAGESIZE);
+    for (uint32_t i = 0; i < touched_count; ++i) {
+        VkDeviceSize low = touched[i].low / page * page, high = (touched[i].high + page - 1) / page * page;
+        madvise(touched[i].map + low, high - low, MADV_DONTNEED);
+    }
+    touched_count = 0;
+}
+static void let_go(unsigned char *map, const struct hybris_bc_shadow_op *op, int destination)
+{
+    VkDeviceSize low = UINT64_MAX, high = 0;
+    for (uint32_t i = 0; i < op->count; ++i) {
+        VkDeviceSize at = destination ? op->segments[i].to : op->segments[i].from;
+        if (at < low) low = at;
+        if (at + op->segments[i].size > high) high = at + op->segments[i].size;
+    }
+    if (low >= high) return;
+    for (uint32_t i = 0; i < touched_count; ++i)
+        if (touched[i].map == map) {
+            if (low < touched[i].low) touched[i].low = low;
+            if (high > touched[i].high) touched[i].high = high;
+            return;
+        }
+    if (touched_count == TOUCHED_MAX) let_go_all();
+    touched[touched_count++] = (struct touched){map, low, high};
+}
+static void stale(struct hybris_bc_resource *resource, const char *why)
+{
+    static int told;
+    resource->emulated.stale = 1;
+    if (!told) {
+        told = 1;
+        fprintf(stderr, "HYBRIS_BC_SHADOW the blocks of a %ux%u texture aren't on storage: %s; reading it back "
+            "gives what was there before\n", resource->extent.width, resource->extent.height, why);
+    }
+}
+static void upload(struct hybris_bc_device *device, struct hybris_bc_resource *resource,
+    const struct hybris_bc_shadow_op *op)
+{
+    VkDeviceSize begin = UINT64_MAX, end = 0;
+    for (uint32_t i = 0; i < op->count; ++i) {
+        if (op->segments[i].from < begin) begin = op->segments[i].from;
+        if (op->segments[i].from + op->segments[i].size > end) end = op->segments[i].from + op->segments[i].size;
+    }
+    const void *mapped = NULL;
+    if (!op->count || !hybris_memory_visibility_host_pointer(device->handle, op->buffer, begin, end - begin, &mapped)) {
+        if (op->count) stale(resource, "uploaded from a buffer the CPU can't see");
+        return;
+    }
+    const unsigned char *bytes = (const unsigned char *)mapped - begin;
+    VkDeviceSize sum = 0;
+    for (uint32_t i = 0; i < op->count; ++i) {
+        const struct hybris_bc_shadow_segment *s = &op->segments[i];
+        memcpy(resource->emulated.shadow + s->to, bytes + s->from, s->size);
+        sum += s->size;
+    }
+    let_go(resource->emulated.shadow, op, 1);
+    written += sum;
+    if (written >= reported + REPORT_STEP) {
+        reported = written / REPORT_STEP * REPORT_STEP;
+        fprintf(stderr, "HYBRIS_BC_SHADOW %llu MB of BC blocks written to storage\n",
+            (unsigned long long)(written >> 20));
+    }
+}
+static void fill(struct hybris_bc_resource *resource, const struct hybris_bc_shadow_op *op)
+{
+    static int told;
+    if (resource->emulated.stale && !told) {
+        told = 1;
+        fprintf(stderr, "HYBRIS_BC_SHADOW reading back a texture whose blocks only the GPU saw\n");
+    }
+    for (uint32_t i = 0; i < op->count; ++i) {
+        const struct hybris_bc_shadow_segment *s = &op->segments[i];
+        memcpy(op->staging + s->to, resource->emulated.shadow + s->from, s->size);
+    }
+    let_go(resource->emulated.shadow, op, 0);
+}
+void hybris_bc_shadow_submit(VkDevice handle, VkCommandBuffer command_handle)
+{
+    if (!hybris_bc_shadow_enabled()) return;
+    struct hybris_bc_device *device = NULL;
+    struct hybris_bc_command *command = hybris_bc_command_find(command_handle, &device);
+    if (!command || !device || device->handle != handle || !command->transfer.shadow.first) return;
+    pthread_mutex_lock(&file_guard);
+    for (const struct hybris_bc_shadow_op *op = command->transfer.shadow.first; op; op = op->next) {
+        struct hybris_bc_resource *resource = hybris_bc_resource_find(device, op->image);
+        if (!resource || !resource->emulated.image) continue;
+        int has_file = resource->emulated.shadow != NULL;
+        switch (op->kind) {
+        case HYBRIS_BC_SHADOW_UPLOAD:
+            if (has_file) upload(device, resource, op);
+            break;
+        case HYBRIS_BC_SHADOW_FILL:
+            if (has_file) fill(resource, op);
+            else for (uint32_t i = 0; i < op->count; ++i)
+                memset(op->staging + op->segments[i].to, 0, op->segments[i].size);
+            break;
+        case HYBRIS_BC_SHADOW_COPY: {
+            struct hybris_bc_resource *source = hybris_bc_resource_find(device, op->source);
+            if (!has_file || !source || !source->emulated.shadow) break;
+            for (uint32_t i = 0; i < op->count; ++i) {
+                const struct hybris_bc_shadow_segment *s = &op->segments[i];
+                memmove(resource->emulated.shadow + s->to, source->emulated.shadow + s->from, s->size);
+            }
+            let_go(resource->emulated.shadow, op, 1);
+            let_go(source->emulated.shadow, op, 0);
+            if (source->emulated.stale) resource->emulated.stale = 1;
+            break;
+        }
+        case HYBRIS_BC_SHADOW_STALE:
+            stale(resource, "written by the GPU");
+            break;
+        }
+    }
+    let_go_all();
+    pthread_mutex_unlock(&file_guard);
+}
diff --git a/hybris/vulkan/compat/bc_shadow.h b/hybris/vulkan/compat/bc_shadow.h
new file mode 100644
index 0000000..1e36ec0
--- /dev/null
+++ b/hybris/vulkan/compat/bc_shadow.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/* Pocket Foundry: a converted BC image keeps only its converted copy (ASTC, EAC) in GPU memory. Its original
+ * blocks, which an application may read back (Factorio saves its atlases that way), live in one deleted file on
+ * storage, whose pages the kernel can drop, as MobileGlues' bc_shadow keeps them for OpenGL ES. The file follows
+ * the GPU at submission: what each recorded command does to an image's blocks runs then, in recording order, from
+ * the application's own mapped upload buffers. HYBRIS_BC_BLOCKS=gpu keeps the blocks in GPU memory instead. */
+#ifndef HYBRIS_BC_SHADOW_H
+#define HYBRIS_BC_SHADOW_H
+#include <vulkan/vulkan.h>
+
+int hybris_bc_shadow_enabled(void);
+/* A range of the file for an image's blocks, mapped, with its place in the file in [offset]; NULL if there is no
+ * file or no room on storage. Released when the image goes. */
+unsigned char *hybris_bc_shadow_reserve(VkDeviceSize size, VkDeviceSize *offset);
+void hybris_bc_shadow_release(unsigned char *map, VkDeviceSize offset, VkDeviceSize size);
+
+enum hybris_bc_shadow_kind {
+    HYBRIS_BC_SHADOW_UPLOAD, /* application buffer -> image blocks */
+    HYBRIS_BC_SHADOW_FILL,   /* image blocks -> our host staging buffer */
+    HYBRIS_BC_SHADOW_COPY,   /* source image blocks -> image blocks */
+    HYBRIS_BC_SHADOW_STALE,  /* the GPU wrote blocks the file can't see */
+};
+/* Byte offsets: in the buffer or staging, and relative to the image's first block. */
+struct hybris_bc_shadow_segment { VkDeviceSize from, to, size; };
+struct hybris_bc_shadow_op {
+    enum hybris_bc_shadow_kind kind;
+    VkImage image, source;
+    VkBuffer buffer;
+    unsigned char *staging;
+    uint32_t count, capacity;
+    struct hybris_bc_shadow_segment *segments;
+    struct hybris_bc_shadow_op *next;
+};
+struct hybris_bc_shadow_ops { struct hybris_bc_shadow_op *first, *last; };
+
+/* Recording: a new op at the end, then its segments. NULL when out of host memory. */
+struct hybris_bc_shadow_op *hybris_bc_shadow_record(struct hybris_bc_shadow_ops *ops,
+    enum hybris_bc_shadow_kind kind, VkImage image);
+int hybris_bc_shadow_segment(struct hybris_bc_shadow_op *op, VkDeviceSize from, VkDeviceSize to, VkDeviceSize size);
+void hybris_bc_shadow_clear(struct hybris_bc_shadow_ops *ops);
+
+/* At submission, for each command buffer in submission order, before the driver sees it. */
+void hybris_bc_shadow_submit(VkDevice device, VkCommandBuffer command);
+#endif
