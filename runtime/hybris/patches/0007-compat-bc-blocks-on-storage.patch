+        struct hybris_bc_shadow_op *fill = hybris_bc_shadow_record(&t->shadow, HYBRIS_BC_SHADOW_FILL, source->handle);
+        if (!fill) { command->state.error = VK_ERROR_OUT_OF_HOST_MEMORY; return; }
