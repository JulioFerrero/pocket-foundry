+/* Pocket Foundry: whether a buffer made with [usage] can be locked for the CPU, as the X server locks one to copy a
+ * frame it doesn't flip. Google's allocator (Pixel 10 and 11) locks only buffers made for CPU access too; Qualcomm's
+ * and Arm's lock any. A buffer that can't be made says nothing either way. */
+static int cpu_lockable(uint32_t width, uint32_t height, int format, int usage)
+{
+    buffer_handle_t handle = NULL;
+    uint32_t stride = 0;
+    void *pixels = NULL;
+    if (hybris_gralloc_allocate((int)width, (int)height, format, usage, &handle, &stride) || !handle) return 1;
+    int locked = !hybris_gralloc_lock(handle, GRALLOC_USAGE_SW_READ_OFTEN, 0, 0, (int)width, (int)height, &pixels);
+    if (locked) hybris_gralloc_unlock(handle);
+    hybris_gralloc_release(handle, 1);
+    return locked;
+}
