+/* Pocket Foundry: dlopen(nullptr) asks for the main program, and dlsym() on that searches the libraries loaded
+ * globally. Under libhybris the Android linker has no main program (somain stays unset), so find_library() took a null
+ * soinfo and crashed on it: ANGLE does this as it starts (a Galaxy S24's Xclipse, a Pixel 11's PowerVR), and the game
+ * crashed before its first frame. It gets this handle instead, which dlsym() takes as RTLD_DEFAULT and dlclose() as
+ * nothing to close. */
+static char g_main_program;
+
+static void* main_program_handle() {
+  return &g_main_program;
+}
