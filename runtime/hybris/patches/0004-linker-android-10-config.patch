+  /* Pocket Foundry: ro.vndk.version, which Pocket Foundry passes in HYBRIS_VNDK_VERSION. Android 10 has no
+   * /linkerconfig: its config is /system/etc/ld.config.<this>.txt, whose paths also hold it. Without it, there's no
+   * config, and so no sphal namespace, where the phone's Vulkan driver lives. */
+  const char* version = getauxval(AT_SECURE) ? nullptr : getenv("HYBRIS_VNDK_VERSION");
+  if (version != nullptr && *version != '\0' && std::string(version) != "current") {
+    return std::string(1, delimiter) + version;
+  }
   return "";
