+/* Each image's blit into its hardware buffer, recorded once for the family of the queue that presents. The
+ * application leaves its image in PRESENT_SRC, and finds it there again. */
+static VkResult prepare_blits(const struct hybris_icd_device *device, struct swapchain_state *state,
+    VkQueue queue)
+{
+    uint32_t family;
+    if (!hybris_icd_queue_family(queue, &family)) return VK_ERROR_UNKNOWN;
+    if (state->pool) return family == state->pool_family ? VK_SUCCESS : VK_ERROR_UNKNOWN;
+    const VkAllocationCallbacks *allocator = state->custom_allocator ? &state->allocator : NULL;
+    PFN_vkCreateCommandPool create_pool = (PFN_vkCreateCommandPool)
+        device->resolver(device->handle, "vkCreateCommandPool");
+    PFN_vkAllocateCommandBuffers allocate = (PFN_vkAllocateCommandBuffers)
+        device->resolver(device->handle, "vkAllocateCommandBuffers");
+    PFN_vkBeginCommandBuffer begin = (PFN_vkBeginCommandBuffer)
+        device->resolver(device->handle, "vkBeginCommandBuffer");
+    PFN_vkEndCommandBuffer end = (PFN_vkEndCommandBuffer)device->resolver(device->handle, "vkEndCommandBuffer");
+    PFN_vkCmdPipelineBarrier barrier = (PFN_vkCmdPipelineBarrier)
+        device->resolver(device->handle, "vkCmdPipelineBarrier");
+    PFN_vkCmdCopyImage copy = (PFN_vkCmdCopyImage)device->resolver(device->handle, "vkCmdCopyImage");
+    PFN_vkCmdClearColorImage clear = (PFN_vkCmdClearColorImage)
+        device->resolver(device->handle, "vkCmdClearColorImage");
+    PFN_vkCreateFence create_fence = (PFN_vkCreateFence)device->resolver(device->handle, "vkCreateFence");
+    PFN_vkDestroyCommandPool destroy_pool = (PFN_vkDestroyCommandPool)
+        device->resolver(device->handle, "vkDestroyCommandPool");
+    if (!create_pool || !allocate || !begin || !end || !barrier || !copy || !clear || !create_fence || !destroy_pool)
+        return VK_ERROR_EXTENSION_NOT_PRESENT;
+    /* HYBRIS_SWAPCHAIN_TEST=1 paints the buffers' top half magenta and copies only the bottom half of each frame: on
+     * a black screen, magenta says the buffers reach it and the frames are black. */
+    const char *test = getenv("HYBRIS_SWAPCHAIN_TEST");
+    uint32_t top = test && !strcmp(test, "1") ? state->extent.height / 2 : 0;
+    if (top) fprintf(stderr, "hybris WSI: test: top half magenta, bottom half the frame\n");
+    VkCommandPoolCreateInfo pool_info = {.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+        .queueFamilyIndex = family};
+    VkResult result = create_pool(device->handle, &pool_info, allocator, &state->pool);
+    if (result != VK_SUCCESS) return result;
+    state->pool_family = family;
+    for (uint32_t i = 0; i < state->count && result == VK_SUCCESS; ++i) {
+        struct swapchain_image *image = &state->images[i];
+        if (!image->blit_done) {
+            VkFenceCreateInfo fence_info = {.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+            result = create_fence(device->handle, &fence_info, allocator, &image->blit_done);
+            if (result != VK_SUCCESS) break;
+        }
+        VkCommandBufferAllocateInfo buffer_info = {.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+            .commandPool = state->pool, .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY, .commandBufferCount = 1};
+        result = allocate(device->handle, &buffer_info, &image->blit);
+        if (result != VK_SUCCESS) break;
+        VkCommandBufferBeginInfo begin_info = {.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+        result = begin(image->blit, &begin_info);
+        if (result != VK_SUCCESS) break;
+        const VkImageSubresourceRange whole = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+        VkImageMemoryBarrier to_copy[2] = {
+            {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+             .oldLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR, .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+             .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+             .image = image->image, .subresourceRange = whole},
+            {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+             .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED, .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+             .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+             .image = image->native_image, .subresourceRange = whole}};
+        barrier(image->blit, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0,
+            0, NULL, 0, NULL, 2, to_copy);
+        if (top) {
+            const VkClearColorValue magenta = {.float32 = {1, 0, 1, 1}};
+            clear(image->blit, image->native_image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &magenta, 1, &whole);
+            VkMemoryBarrier cleared = {.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT, .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT};
+            barrier(image->blit, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0,
+                1, &cleared, 0, NULL, 0, NULL);
+        }
+        const VkImageSubresourceLayers layers = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+        VkImageCopy region = {.srcSubresource = layers, .srcOffset = {0, (int32_t)top, 0}, .dstSubresource = layers,
+            .dstOffset = {0, (int32_t)top, 0}, .extent = {state->extent.width, state->extent.height - top, 1}};
+        /* Byte for byte, not converted: the X server reads the buffer in its window's BGRX order, whatever format
+         * the buffer is labelled with. */
+        copy(image->blit, image->image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, image->native_image,
+            VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+        VkImageMemoryBarrier to_present[2] = {
+            {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, .srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+             .oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, .newLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
+             .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+             .image = image->image, .subresourceRange = whole},
+            {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+             .oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, .newLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
+             .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+             .image = image->native_image, .subresourceRange = whole}};
+        barrier(image->blit, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0,
+            0, NULL, 0, NULL, 2, to_present);
+        result = end(image->blit);
+    }
+    if (result != VK_SUCCESS) {
+        // Freeing the pool frees the buffers recorded so far: the next present starts over.
+        destroy_pool(device->handle, state->pool, allocator);
+        state->pool = VK_NULL_HANDLE;
+        for (uint32_t i = 0; i < state->count; ++i) state->images[i].blit = VK_NULL_HANDLE;
+    }
+    return result;
+}
+
+/* Submits the image's blit after the application's waits. Its buffer came back only after the image's previous
+ * blit had finished, so the wait for that one returns at once. */
+static VkResult submit_blit(const struct hybris_icd_device *device, struct swapchain_state *state,
+    VkQueue queue, struct swapchain_image *image, uint32_t waits, const VkSemaphore *wait)
+{
+    VkResult result = prepare_blits(device, state, queue);
+    if (result != VK_SUCCESS) return result;
+    PFN_vkWaitForFences wait_fences = (PFN_vkWaitForFences)device->resolver(device->handle, "vkWaitForFences");
+    PFN_vkResetFences reset_fences = (PFN_vkResetFences)device->resolver(device->handle, "vkResetFences");
+    PFN_vkQueueSubmit submit = (PFN_vkQueueSubmit)device->resolver(device->handle, "vkQueueSubmit");
+    if (image->blitting) {
+        result = wait_fences(device->handle, 1, &image->blit_done, VK_TRUE, UINT64_MAX);
+        if (result == VK_SUCCESS) result = reset_fences(device->handle, 1, &image->blit_done);
+        if (result != VK_SUCCESS) return result;
+        image->blitting = 0;
+    }
+    VkPipelineStageFlags *stages = waits ? malloc(waits * sizeof(*stages)) : NULL;
+    if (waits && !stages) return VK_ERROR_OUT_OF_HOST_MEMORY;
+    for (uint32_t i = 0; i < waits; ++i) stages[i] = VK_PIPELINE_STAGE_TRANSFER_BIT;
+    VkSubmitInfo copy = {.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+        .waitSemaphoreCount = waits, .pWaitSemaphores = wait, .pWaitDstStageMask = stages,
+        .commandBufferCount = 1, .pCommandBuffers = &image->blit,
+        .signalSemaphoreCount = 1, .pSignalSemaphores = &image->blitted};
+    result = submit(queue, 1, &copy, image->blit_done);
+    free(stages);
+    image->blitting = result == VK_SUCCESS;
+    return result;
+}
