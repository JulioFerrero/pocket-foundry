+        if (needs.memoryTypeBits & (1u << i)) type = i;
+    if (type == UINT32_MAX) return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+    VkMemoryAllocateInfo allocate_info = {.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+        .allocationSize = needs.size, .memoryTypeIndex = type};
+    result = allocate(device->handle, &allocate_info, allocator, memory);
+    return result == VK_SUCCESS ? bind(device->handle, *image, *memory, 0) : result;
+}
