+/* The server writes a byte to the socket, then reads the buffer from it: send
+ * it first, and keep our end open until the server has processed the request. */
+static int import(Owner *o, Buffer *b) {
+    auto *buffer = hybris_gralloc_get_hardware_buffer(b->handle);
+    send_hardware_buffer_fn send = send_hardware_buffer();
+    if (!buffer || !send) return -ENOTSUP;
+    int pair[2];
+    if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, pair)) return -errno;
+    if (send(buffer, pair[0])) { close(pair[0]); close(pair[1]); return -EIO; }
+    b->pixmap = xcb_generate_id(o->connection);
+    /* libxcb owns pair[1] once sent. The server takes the stride from the buffer. */
+    unsigned sequence = xcb_dri3_pixmap_from_buffers_checked(o->connection, b->pixmap, o->window, 1,
+        b->width, b->height, b->stride * 4, 0, 0, 0, 0, 0, 0, 0, o->depth, 32,
+        AHARDWAREBUFFER_SOCKET_FD, &pair[1]).sequence;
+    int error = check(o->connection, sequence);
+    close(pair[0]);
+    if (error) b->pixmap = 0;
+    return error;
